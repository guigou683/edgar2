# --- Données & secrets (jamais versionnés) ---
/data/
/documents/
/ollama/
/qdrant/
.env

# --- Assets binaires locaux (fonts/icons éventuels, non versionnés) ---
# Les libs JS tierces (app/static/vendor/*.js) SONT versionnées : dépôt autonome,
# reproductible et 100 % hors-ligne (aucun CDN).
app/static/fonts/*
app/static/icons/*

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# --- Modèles / caches offline ---
*.gguf
.cache/
hf_cache/

# --- OS / éditeurs ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# Paquets d'installation hors-ligne (volumineux, non versionnés)
/docker_offline/
/offline_bundle/
