# =====================================================================
# EDGAR v2 — variables d'environnement (copier vers .env, ne pas versionner)
# Ports décalés par rapport à la v1 pour cohabitation sur le même hôte.
# =====================================================================

# --- Ports exposés sur l'hôte ---
APP_PORT=8800
QDRANT_PORT=7333
OLLAMA_PORT=11435

# --- URLs internes (réseau Docker Compose) ---
OLLAMA_URL=http://ollama:11434
QDRANT_URL=http://qdrant:6333

# --- Modèles (bge-m3 imposé pour le dense ; LLM par défaut mistral:7b) ---
EMBED_MODEL=bge-m3
LLM_MODEL=mistral:7b

# --- Forçage du mode hors-ligne ---
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# --- Secret de signature des cookies/sessions/CSRF (CHANGER en production) ---
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
EDGAR_SECRET_KEY=change-me-bootstrap-secret-please-regenerate

# --- TLS : mettre 1 si servi derrière un proxy HTTPS (cookies Secure) ---
EDGAR_TLS=0
